# fifine AM8: access to the vendor HID interface without sudo, and apply sound defaults on plug-in.
# Must sort before 73-seat-late.rules, which turns the uaccess tag into an ACL.
SUBSYSTEM=="usb", ACTION=="add|change", ATTR{idVendor}=="3142", ATTR{idProduct}=="a010", MODE="0660", GROUP="plugdev", TAG+="uaccess", TAG+="systemd", ENV{SYSTEMD_USER_WANTS}+="am8-defaults.service"
